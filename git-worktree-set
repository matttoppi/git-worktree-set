#!/usr/bin/env bash
# git-worktree-set: one directory, one branch, one worktree for each repository.
#
# A worktree set lives at <root>/.worktrees/<name>/<repository>, where <root> is
# the directory that holds the repositories. There is no state file: the
# members of a set are the worktrees in its directory, and Git holds the rest.
set -euo pipefail

SET_DIRECTORY=.worktrees
LOCK_REASON_PREFIX="git-worktree-set"
SETUP_HOOK=.worktree-set-setup
# A note for other tools: the agent threads that worked in a set, one ID per
# line. The tool writes it and never reads it.
THREAD_VARIABLE=T3CODE_THREAD_ID
THREAD_NOTE=.worktree-set.threads
# The path of this script, usable after a change of directory.
self=$0
case $self in /*) ;; *) self=$PWD/$self ;; esac
usage() {
  cat <<'EOF'
usage: git worktree-set new [--from <ref>] [--all] <name> [<repository>...]
       git worktree-set add <repository>...
       git worktree-set status [--porcelain] [<name>]
       git worktree-set remove [--dry-run] [<name>]
       git worktree-set remove --merged [--dry-run]
       git worktree-set land [--into <branch>] [--dry-run] [<name>]

new     Add one worktree for each repository at <root>/.worktrees/<name>/,
        all on branch <name>. Prints the directory of the set on stdout.
        With no repository, it makes an empty set; use `add` later.
add     Inside a set: add more repositories to it.
status  Show branch, changed files and commits that are on no remote.
        Without <name>: the set that contains the current directory, else all.
remove  Remove a set. Refuses if any work could be lost. Has no force option.
        --merged: remove each set that had no activity for one day and in
        which no branch has changes outside the default branch.
        --dry-run: run all checks and report the result; change nothing.
land    Merge the branch of each worktree of a set into a local branch, such
        as an integration branch: --into <branch>, else the default branch
        that worktree-set.defaultBranch sets. Checks all worktrees first and
        changes nothing if one check fails. Fast-forwards when it can, else
        makes a merge commit. Updates the checkout that has the branch.
        Refuses main, master, dev, and prod. Never pushes.

The default branch of a repository is the value of the Git configuration key
worktree-set.defaultBranch, else the default branch of origin.
EOF
}

die() {
  printf 'git-worktree-set: %s\n' "$*" >&2
  exit 1
}

info() {
  printf '%s\n' "$*" >&2
}

physical_path() {
  (cd "$1" && pwd -P)
}

# The main checkout of the repository that owns the worktree at $1.
# ponytail: assumes a normal clone; a bare repository or a submodule gives a wrong path.
main_checkout() {
  local common
  common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  dirname "$common"
}

# The root is the directory that holds the main checkouts. Found from Git alone:
# from inside any checkout or worktree, or from a directory that contains one.
find_root() {
  if [ -n "${GIT_WORKTREE_SET_ROOT:-}" ]; then
    physical_path "$GIT_WORKTREE_SET_ROOT"
    return
  fi
  local directory main child
  if main=$(main_checkout "$PWD"); then
    physical_path "$main/.."
    return
  fi
  # Not in a repository: the current directory is the root, or it is in a set.
  for directory in "$PWD" "${PWD%/"$SET_DIRECTORY"*}"; do
    for child in "$directory"/*/; do
      if [ -e "$child.git" ] && main=$(main_checkout "$child"); then
        physical_path "$main/.."
        return
      fi
    done
  done
  die "no repositories found in $PWD; run this in the directory that holds them"
}

set_path() {
  printf '%s/%s/%s' "$root" "$SET_DIRECTORY" "${1//\//-}"
}

# Directory name of the set that contains the current directory, if any.
current_set() {
  local here
  here=$(pwd -P)
  case $here/ in
    "$root/$SET_DIRECTORY"/*/)
      here=${here#"$root/$SET_DIRECTORY/"}
      printf '%s' "${here%%/*}"
      ;;
  esac
}

# Appends the thread ID from $THREAD_VARIABLE to the note of the set at $1, if
# the note does not have it. Best effort: a failure changes nothing and prints
# nothing.
record_thread() {
  local thread=${!THREAD_VARIABLE:-} note=$1/$THREAD_NOTE
  [ -n "$thread" ] && [ -d "$1" ] && [ ! -e "$1/.git" ] || return 0
  case $thread in *$'\n'*) return 0 ;; esac
  if ! grep -qxF -- "$thread" "$note" 2>/dev/null; then
    { printf '%s\n' "$thread" >>"$note"; } 2>/dev/null || true
  fi
}

# Records the thread in the set that contains the current directory, if any.
record_thread_in_current_set() {
  local name
  name=$(current_set)
  if [ -n "$name" ]; then record_thread "$root/$SET_DIRECTORY/$name"; fi
}

set_worktrees() {
  local child
  for child in "$1"/*/; do
    if [ -e "$child.git" ]; then printf '%s\n' "${child%/}"; fi
  done
}

# The ref for <name>: origin/<name>, or the local branch <name> when it
# contains origin/<name> and has more commits. Any other commit-ish as it is.
named_ref() {
  local main=$1 name=$2
  if git -C "$main" show-ref --verify --quiet "refs/remotes/origin/$name"; then
    if git -C "$main" show-ref --verify --quiet "refs/heads/$name" &&
      [ -n "$(git -C "$main" rev-list -1 "refs/remotes/origin/$name..refs/heads/$name")" ]; then
      if git -C "$main" merge-base --is-ancestor "refs/remotes/origin/$name" "refs/heads/$name"; then
        printf '%s' "$name"
        return
      fi
      info "warning: $(basename "$main"): local $name and origin/$name differ; using origin/$name"
    fi
    printf 'origin/%s' "$name"
    return
  fi
  git -C "$main" rev-parse --verify --quiet "$name^{commit}" >/dev/null || return 1
  printf '%s' "$name"
}

base_ref() {
  local main=$1 from=$2 ref
  if [ -z "$from" ]; then from=$(git -C "$main" config worktree-set.defaultBranch) || true; fi
  if [ -n "$from" ]; then
    named_ref "$main" "$from" || die "$(basename "$main"): cannot find '$from'"
    return
  fi
  if ref=$(git -C "$main" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); then
    printf '%s' "$ref"
    return
  fi
  for ref in origin/main origin/master; do
    if git -C "$main" rev-parse --verify --quiet "$ref^{commit}" >/dev/null; then
      printf '%s' "$ref"
      return
    fi
  done
  printf 'HEAD'
}

# Copy files that match .worktreeinclude (at the root or in the repository) and
# that Git ignores. A tracked file is never copied, so a secret cannot become a
# change in the worktree.
# ponytail: file names with a newline or a quote character are not supported.
copy_included() {
  local main=$1 target=$2 patterns file
  patterns=$(mktemp)
  cat "$root/.worktreeinclude" "$main/.worktreeinclude" 2>/dev/null >"$patterns" || true
  if [ -s "$patterns" ]; then
    git -C "$main" ls-files --others --ignored --exclude-from="$patterns" |
      { git -C "$main" check-ignore --stdin || true; } |
      while IFS= read -r file; do
        [ ! -e "$target/$file" ] || continue
        mkdir -p "$(dirname "$target/$file")"
        cp -p "$main/$file" "$target/$file"
      done
  fi
  rm -f "$patterns"
}

# A stable block of 10 ports for each set name, 10000 to 19990.
# ponytail: two names can hash to the same block (1 in 1000); the hook can use its own scheme.
port_base() {
  local sum
  sum=$(printf '%s' "$1" | cksum)
  printf '%s' $((10000 + ${sum%% *} % 1000 * 10))
}

cmd_new() {
  local from="" all=false arguments=()
  while [ $# -gt 0 ]; do
    case $1 in
      --from)
        [ $# -ge 2 ] || die "--from needs a ref"
        from=$2
        shift 2
        ;;
      --from=*)
        from=${1#--from=}
        shift
        ;;
      --all)
        all=true
        shift
        ;;
      --)
        shift
        arguments+=("$@")
        break
        ;;
      -*) die "unknown option '$1'" ;;
      *)
        arguments+=("$1")
        shift
        ;;
    esac
  done
  set -- ${arguments[@]+"${arguments[@]}"}
  [ $# -ge 1 ] || die "new needs a name"
  local name=$1
  shift
  git check-ref-format --branch "$name" >/dev/null 2>&1 || die "'$name' is not a valid branch name"

  local repositories=() repository child
  if $all; then
    for child in "$root"/*/; do
      if [ -e "$child.git" ]; then repositories+=("$(basename "$child")"); fi
    done
  else
    for repository in "$@"; do repositories+=("${repository%/}"); done
  fi

  local directory main target base bases=() index=0 lock=()
  directory=$(set_path "$name")
  [ ! -e "$directory/.git" ] || die "$directory is a single worktree, not a set"

  # Check everything before the first change.
  for repository in ${repositories[@]+"${repositories[@]}"}; do
    main=$root/$repository
    case $repository in */*) die "'$repository' is not a directory name in $root" ;; esac
    [ -e "$main/.git" ] || die "'$repository' is not a repository in $root"
    [ ! -e "$directory/$repository" ] || die "$directory/$repository exists already"
    if git -C "$main" worktree list --porcelain | grep -qxF "branch refs/heads/$name"; then
      die "$repository: branch '$name' is checked out in another worktree" \
        "(if you deleted a set folder by hand, run: git worktree-set remove $name)"
    fi
    if git -C "$main" remote get-url origin >/dev/null 2>&1; then
      git -C "$main" fetch --quiet origin 2>/dev/null || info "warning: $repository: fetch failed, using local refs"
    fi
    base=$(base_ref "$main" "$from")
    bases+=("$base")
  done

  mkdir -p "$directory"
  record_thread "$directory"
  for repository in ${repositories[@]+"${repositories[@]}"}; do
    main=$root/$repository
    target=$directory/$repository
    base=${bases[$index]}
    index=$((index + 1))
    # The lock makes `git worktree remove --force` and `git worktree prune` refuse.
    lock=(--lock --reason "$LOCK_REASON_PREFIX: $name")
    if git -C "$main" show-ref --verify --quiet "refs/heads/$name"; then
      git -C "$main" worktree add --quiet "${lock[@]}" "$target" "$name" >&2
      info "$repository: existing branch $name"
    elif git -C "$main" show-ref --verify --quiet "refs/remotes/origin/$name"; then
      # Continue the pushed work, for example after `remove` deleted the local branch.
      git -C "$main" worktree add --quiet "${lock[@]}" --track -b "$name" "$target" "origin/$name" >&2
      info "$repository: existing branch origin/$name"
    else
      git -C "$main" worktree add --quiet "${lock[@]}" --no-track -b "$name" "$target" "$base" >&2
      info "$repository: new branch $name from $base"
    fi
    copy_included "$main" "$target"
  done

  if [ -x "$root/$SETUP_HOOK" ]; then
    (
      cd "$directory"
      GIT_WORKTREE_SET_NAME=$name \
        GIT_WORKTREE_SET_PATH=$directory \
        GIT_WORKTREE_SET_ROOT=$root \
        GIT_WORKTREE_SET_REPOSITORIES="${repositories[*]-}" \
        GIT_WORKTREE_SET_PORT_BASE=$(port_base "$name") \
        "$root/$SETUP_HOOK"
    ) >&2 || info "warning: $SETUP_HOOK failed; the set is usable, but its setup is not complete"
  fi
  printf '%s\n' "$directory"
}

# Add repositories to the set that contains the current directory.
cmd_add() {
  local directory worktree name
  name=$(current_set)
  [ -n "$name" ] || die "add works only inside a set; use: new <name> <repository>..."
  directory=$root/$SET_DIRECTORY/$name
  # The directory name has a dash where the branch name has a slash, so read
  # the branch from a worktree of the set when there is one.
  worktree=$(set_worktrees "$directory" | head -n 1)
  if [ -n "$worktree" ]; then name=$(git -C "$worktree" symbolic-ref --quiet --short HEAD) || true; fi
  [ $# -ge 1 ] || die "add needs at least one repository"
  cmd_new "$name" "$@"
}

cmd_status() {
  local porcelain=false name=""
  while [ $# -gt 0 ]; do
    case $1 in
      --porcelain) porcelain=true ;;
      -*) die "unknown option '$1'" ;;
      *) name=$1 ;;
    esac
    shift
  done
  local sets=() directory worktree branch changed unpushed summary location
  if [ -n "$name" ]; then
    sets=("$(set_path "$name")")
  elif [ -n "$(current_set)" ]; then
    sets=("$root/$SET_DIRECTORY/$(current_set)")
  else
    for directory in "$root/$SET_DIRECTORY"/*/; do
      if [ -d "$directory" ]; then sets+=("${directory%/}"); fi
    done
  fi

  for directory in ${sets[@]+"${sets[@]}"}; do
    [ -d "$directory" ] || die "no worktree set at $directory"
    $porcelain || printf '%s  %s\n' "$(basename "$directory")" "$directory"
    if [ -e "$directory/.git" ]; then
      $porcelain || printf '  (a single worktree, not a set)\n'
      continue
    fi
    while IFS= read -r worktree; do
      branch=$(git -C "$worktree" symbolic-ref --quiet --short HEAD) || branch="(detached)"
      changed=$(git -C "$worktree" --no-optional-locks status --porcelain | wc -l | tr -d ' ')
      unpushed=$(git -C "$worktree" rev-list --count HEAD --not --remotes)
      if $porcelain; then
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
          "$(basename "$directory")" "$(basename "$worktree")" "$branch" "$changed" "$unpushed" "$worktree"
      else
        summary=""
        if [ "$changed" != 0 ]; then summary="$changed changed"; fi
        if [ "$unpushed" != 0 ]; then summary="${summary:+$summary, }$unpushed on no remote"; fi
        if [ "$branch" = "(detached)" ]; then
          location=$(set_branch_location "$worktree")
          if [ -n "$location" ]; then summary="${summary:+$summary, }$location"; fi
        fi
        printf '  %-28s %-32s %s\n' "$(basename "$worktree")" "$branch" "${summary:-clean}"
      fi
    done < <(set_worktrees "$directory")
  done
  record_thread_in_current_set
}

# For a detached worktree at $1: where its set branch is checked out, if it is.
# The set branch is in the lock reason.
set_branch_location() {
  local main lock branch path
  main=$(main_checkout "$1") || return 0
  lock=$(lock_line "$main" "$1")
  case $lock in "locked $LOCK_REASON_PREFIX: "*) ;; *) return 0 ;; esac
  branch=${lock#"locked $LOCK_REASON_PREFIX: "}
  path=$(branch_checkout "$main" "$branch")
  if [ -n "$path" ]; then printf '%s is checked out at %s\n' "$branch" "$path"; fi
}

# The worktree that has branch $2 checked out, if any.
branch_checkout() {
  git -C "$1" worktree list --porcelain | awk -v line="branch refs/heads/$2" '
    /^worktree / { path = substr($0, 10) }
    $0 == line { print path }'
}

# The `locked` line of `git worktree list --porcelain` for the worktree at $2.
lock_line() {
  git -C "$1" worktree list --porcelain | awk -v target="$(physical_path "$2")" '
    /^worktree / { found = ($0 == "worktree " target) }
    found && /^locked/ { print }'
}

# Prints one line for each reason that removal of the worktree at $1 can lose work.
removal_blockers() {
  local worktree=$1 main lock status
  if [ ! -f "$worktree/.git" ]; then
    echo "an independent repository, not a worktree"
    return
  fi
  main=$(main_checkout "$worktree") || {
    echo "not a usable worktree"
    return
  }
  status=$(git -C "$worktree" --no-optional-locks status --porcelain) || {
    echo "git status failed"
    return
  }
  if [ -n "$status" ]; then printf '%s\n' "$status" | sed 's/^/not committed: /'; fi
  if ! git -C "$worktree" symbolic-ref --quiet HEAD >/dev/null &&
    [ "$(git -C "$worktree" rev-list --count HEAD --not --branches --remotes --tags)" != 0 ]; then
    echo "detached HEAD has commits that are on no branch"
  fi
  lock=$(lock_line "$main" "$worktree")
  case $lock in
    "" | "locked $LOCK_REASON_PREFIX"*) ;;
    *) echo "locked by another owner ($lock)" ;;
  esac
}

# Entries of a set directory that are not worktrees. Safe to delete: a symbolic
# link, the setup hook output file, the thread note, and .DS_Store.
set_extra_entries() {
  local kind=$1 directory=$2 entry safe
  for entry in "$directory"/* "$directory"/.[!.]*; do
    if [ ! -e "$entry" ] && [ ! -L "$entry" ]; then continue; fi
    if [ ! -L "$entry" ] && [ -e "$entry/.git" ]; then continue; fi
    safe=false
    case $(basename "$entry") in .worktree-set.env | "$THREAD_NOTE" | .DS_Store) safe=true ;; esac
    if [ -L "$entry" ]; then safe=true; fi
    if { [ "$kind" = safe ] && $safe; } || { [ "$kind" = unsafe ] && ! $safe; }; then
      printf '%s\n' "$entry"
    fi
  done
}

# True if a merge of branch $2 into branch $3, else into the default branch,
# changes nothing. This finds a branch that was merged with a squash or a rebase.
changes_are_in_base() {
  local main=$1 branch=$2 base=${3:-} merged
  if [ -z "$base" ]; then base=$(base_ref "$main" ""); fi
  merged=$(git -C "$main" merge-tree --write-tree "$base" "$branch" 2>/dev/null) || return 1
  [ "$merged" = "$(git -C "$main" rev-parse "$base^{tree}")" ]
}

# True if no branch of the set at $1 has changes outside the default branch.
# A new set with no commits counts as merged, as a new branch does for
# `git branch --merged`.
set_is_merged() {
  local worktree main branch
  while IFS= read -r worktree; do
    main=$(main_checkout "$worktree") || return 1
    branch=$(git -C "$worktree" symbolic-ref --quiet --short HEAD) || return 1
    git -C "$main" fetch --quiet origin 2>/dev/null || true
    changes_are_in_base "$main" "$branch" || return 1
  done < <(set_worktrees "$1")
}

# True if the set at $1 had no activity for one day. `new` and `add` change the
# set directory. Git changes the index or the HEAD log of a worktree when it
# sees or records work there. A change to a file inside a worktree does not
# change the set directory.
set_is_idle() {
  local worktree git_directory
  [ -n "$(find "$1" -maxdepth 0 -mmin +1440)" ] || return 1
  while IFS= read -r worktree; do
    git_directory=$(git -C "$worktree" rev-parse --absolute-git-dir) || return 1
    [ -z "$(find "$git_directory/index" "$git_directory/logs/HEAD" -mmin -1440 2>/dev/null)" ] || return 1
  done < <(set_worktrees "$1")
}

# Unlocks and prunes the worktree records of the set at $1 when its folder was
# deleted without Git, for example with rm -rf. The files are gone, so the lock
# protects nothing, and the records block `new` for the same name. Branches stay.
# With $2 = true, it only reports.
forget_deleted_set() {
  local directory=$1 dry_run=$2 child path found=false
  for child in "$root"/*/; do
    [ -e "$child.git" ] || continue
    while IFS= read -r path; do
      [ ! -e "$path" ] || continue
      found=true
      if $dry_run; then
        info "$(basename "$child"): would remove the record of the deleted worktree $path"
        continue
      fi
      git -C "$child" worktree unlock "$path" 2>/dev/null || true
      git -C "$child" worktree prune
      info "$(basename "$child"): removed the record of the deleted worktree $path; its branch stays"
      found=true
    done < <(git -C "$child" worktree list --porcelain |
      awk -v prefix="worktree $directory/" 'index($0, prefix) == 1 { print substr($0, 10) }')
  done
  $found
}

cmd_remove() {
  local name="" directory merged=false dry_run=false
  while [ $# -gt 0 ]; do
    case $1 in
      --merged) merged=true ;;
      --dry-run) dry_run=true ;;
      -*) die "unknown option '$1'" ;;
      *) name=$1 ;;
    esac
    shift
  done
  if $merged; then
    [ -z "$name" ] || die "remove --merged takes no name"
    cd "$root"
    for directory in "$root/$SET_DIRECTORY"/*/; do
      [ -d "$directory" ] || continue
      name=$(basename "$directory")
      # A task can be about to start in a new set, which has no changes yet.
      if [ -e "$directory.git" ]; then
        info "$name: kept (a single worktree, not a set)"
      elif ! set_is_idle "${directory%/}"; then
        info "$name: kept (active in the last day)"
      elif set_is_merged "${directory%/}"; then
        info "$name:"
        # A separate process, so that a refusal stops only this removal.
        if $dry_run; then
          GIT_WORKTREE_SET_ROOT=$root "$BASH" "$self" remove --dry-run "$name" || true
        else
          GIT_WORKTREE_SET_ROOT=$root "$BASH" "$self" remove "$name" || true
        fi
      else
        info "$name: kept (not merged)"
      fi
    done
    return
  fi
  if [ -z "$name" ]; then name=$(current_set); fi
  [ -n "$name" ] || die "remove needs a name when the current directory is not in a set"
  directory=$(set_path "$name")
  if [ ! -d "$directory" ]; then
    forget_deleted_set "$directory" "$dry_run" || die "no worktree set at $directory"
    return
  fi
  [ ! -e "$directory/.git" ] || die "$directory is a single worktree, not a set; use git worktree remove"

  local blocked=false worktree blockers entry
  while IFS= read -r worktree; do
    blockers=$(removal_blockers "$worktree")
    if [ -n "$blockers" ]; then
      blocked=true
      info "$(basename "$worktree"):"
      info "$(printf '%s\n' "$blockers" | sed 's/^/  /')"
    fi
  done < <(set_worktrees "$directory")
  while IFS= read -r entry; do
    blocked=true
    info "not part of a worktree: $entry"
  done < <(set_extra_entries unsafe "$directory")
  if $blocked; then die "nothing was removed; resolve the items above first"; fi
  if $dry_run; then
    info "$name: would be removed; nothing was changed"
    return
  fi

  # Leave the set before Git deletes the current directory.
  cd "$root"
  local main branch set_branch lock commit
  while IFS= read -r worktree; do
    main=$(main_checkout "$worktree")
    branch=$(git -C "$worktree" symbolic-ref --quiet --short HEAD) || branch=""
    # The set branch is in the lock reason. A set made by hand has no lock.
    lock=$(lock_line "$main" "$worktree")
    case $lock in
      "locked $LOCK_REASON_PREFIX: "*) set_branch=${lock#"locked $LOCK_REASON_PREFIX: "} ;;
      *) set_branch=$name ;;
    esac
    git -C "$main" worktree unlock "$worktree" 2>/dev/null || true
    if ! git -C "$main" worktree remove "$worktree" >&2; then
      git -C "$main" worktree lock --reason "$LOCK_REASON_PREFIX: $set_branch" "$worktree" 2>/dev/null || true
      die "Git refused to remove $worktree; it and the remaining worktrees stay"
    fi
    if [ -z "$branch" ]; then
      info "$(basename "$worktree"): removed"
      continue
    fi
    if [ "$branch" != "$set_branch" ]; then
      info "$(basename "$worktree"): removed; branch $branch kept (it is not the branch of the set)"
      continue
    fi
    # Delete the branch only when no commit can be lost.
    commit=$(git -C "$main" rev-parse --short "$branch")
    if [ "$(git -C "$main" rev-list --count "$branch" --not --remotes)" != 0 ]; then
      git -C "$main" fetch --quiet origin 2>/dev/null || true
    fi
    if [ "$(git -C "$main" rev-list --count "$branch" --not --remotes)" = 0 ]; then
      git -C "$main" branch --quiet -D "$branch"
      info "$(basename "$worktree"): removed; branch $branch deleted, was $commit (all commits are on a remote)"
    elif changes_are_in_base "$main" "$branch"; then
      git -C "$main" branch --quiet -D "$branch"
      info "$(basename "$worktree"): removed; branch $branch deleted, was $commit (its changes are in the default branch)"
    else
      info "$(basename "$worktree"): removed; branch $branch kept (it has changes that are not merged or pushed)"
    fi
  done < <(set_worktrees "$directory")

  while IFS= read -r entry; do
    rm "$entry"
  done < <(set_extra_entries safe "$directory")
  rmdir "$directory"
  rmdir "$root/$SET_DIRECTORY" 2>/dev/null || true
}

# Plans the landing of the worktree at $1 into branch $2, else into the
# default branch that worktree-set.defaultBranch sets. Prints one line with tab
# separators: action, target branch, target commit before, target commit after,
# head of the worktree, and the checkout that has the target branch, if any.
# The action is "landed" (the changes are in the target already),
# "fast-forward", or "merge". If the landing cannot go ahead, it prints
# "blocked" and a reason instead, one line for each reason.
# Moves no branch and changes no worktree. It can write Git objects, and it
# refreshes the index of the target checkout as git status does.
landing_plan() {
  local worktree=$1 target=$2 branch status head old new action output result checkout pending
  if ! branch=$(git -C "$worktree" symbolic-ref --quiet --short HEAD); then
    printf 'blocked\tdetached HEAD; check out the branch of the set\n'
    return
  fi
  if [ -z "$target" ] && ! target=$(git -C "$worktree" config worktree-set.defaultBranch); then
    printf 'blocked\tno target branch; use --into <branch>, or set worktree-set.defaultBranch\n'
    return
  fi
  case $(printf '%s' "$target" | tr '[:upper:]' '[:lower:]') in # a case-insensitive file system matches Main to main
    main | master | dev | prod)
      printf 'blocked\tland refuses %s; main, master, dev, and prod need a reviewed promotion\n' "$target"
      return
      ;;
  esac
  if [ "$target" = "$branch" ]; then
    printf 'blocked\t%s is the branch of the set\n' "$target"
    return
  fi
  if ! old=$(git -C "$worktree" rev-parse --verify --quiet "refs/heads/$target"); then
    printf 'blocked\tno local branch %s\n' "$target"
    return
  fi
  if ! status=$(git -C "$worktree" --no-optional-locks status --porcelain); then
    printf 'blocked\tgit status failed\n'
    return
  fi
  if [ -n "$status" ]; then
    printf '%s\n' "$status" | awk '{ print "blocked\tnot committed: " $0 }'
    return
  fi
  head=$(git -C "$worktree" rev-parse HEAD)
  if changes_are_in_base "$worktree" "$head" "$old"; then
    printf 'landed\t%s\t%s\t%s\t%s\t\n' "$target" "$old" "$old" "$head"
    return
  fi

  if git -C "$worktree" merge-base --is-ancestor "$old" "$head"; then
    action=fast-forward
    new=$head
  else
    output=$(git -C "$worktree" merge-tree --write-tree --name-only --no-messages "$old" "$head") && result=0 || result=$?
    if [ "$result" = 1 ]; then
      # A conflict of directory renames can name no file.
      printf '%s\n' "$output" | awk -v target="$target" '
        NR > 1 { print "blocked\tmerge conflict with " target ": " $0; named = 1 }
        END { if (!named) print "blocked\tmerge conflict with " target }'
      return
    elif [ "$result" != 0 ]; then
      printf 'blocked\tgit merge-tree failed\n'
      return
    fi
    if ! new=$(git -C "$worktree" commit-tree "$output" -p "$old" -p "$head" -m "Merge branch '$branch' into $target"); then
      printf 'blocked\tgit commit-tree failed\n'
      return
    fi
    action=merge
  fi

  # The checkout that has the target branch gets the new files, so its
  # changes must not be in the way. These are the checks of git merge.
  checkout=$(branch_checkout "$worktree" "$target")
  if [ -n "$checkout" ]; then
    for pending in MERGE_HEAD CHERRY_PICK_HEAD; do
      if git -C "$checkout" rev-parse --verify --quiet "$pending" >/dev/null; then
        printf 'blocked\tthe checkout at %s has %s; finish or abort that operation\n' "$checkout" "$pending"
        return
      fi
    done
    git -C "$checkout" update-index -q --refresh >/dev/null 2>&1 || true
    if ! output=$(git -C "$checkout" read-tree -n -m -u "$old" "$new" 2>&1); then
      printf '%s\n' "$output" | awk -v checkout="$checkout" '{ sub(/^error: /, ""); print "blocked\tthe checkout at " checkout ": " $0 }'
      return
    fi
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$action" "$target" "$old" "$new" "$head" "$checkout"
}

cmd_land() {
  local into="" dry_run=false name="" directory
  while [ $# -gt 0 ]; do
    case $1 in
      --into)
        [ $# -ge 2 ] || die "--into needs a branch"
        into=$2
        shift
        ;;
      --into=*) into=${1#--into=} ;;
      --dry-run) dry_run=true ;;
      -*) die "unknown option '$1'" ;;
      *) name=$1 ;;
    esac
    shift
  done
  if [ -z "$name" ]; then name=$(current_set); fi
  [ -n "$name" ] || die "land needs a name when the current directory is not in a set"
  directory=$(set_path "$name")
  [ -d "$directory" ] || die "no worktree set at $directory"
  [ ! -e "$directory/.git" ] || die "$directory is a single worktree, not a set"

  local plan=() blocked=false worktree lines
  while IFS= read -r worktree; do
    lines=$(landing_plan "$worktree" "$into" </dev/null)
    case $lines in
      blocked*)
        blocked=true
        info "$(basename "$worktree"):"
        info "$(printf '%s\n' "$lines" | cut -f 2- | sed 's/^/  /')"
        ;;
      *) plan+=("$worktree"$'\t'"$lines") ;;
    esac
  done < <(set_worktrees "$directory")
  if $blocked; then die "nothing was landed; resolve the items above first"; fi
  [ ${#plan[@]} -gt 0 ] || die "the set at $directory has no repositories"
  $dry_run || record_thread_in_current_set

  local row action target old new head checkout repository count kind
  for row in "${plan[@]}"; do
    IFS=$'\t' read -r worktree action target old new head checkout <<<"$row"
    repository=$(basename "$worktree")
    if [ "$action" = landed ]; then
      printf '%s: already in %s; nothing changed\n' "$repository" "$target"
      continue
    fi
    case $action in
      fast-forward) kind="a fast-forward from $(git -C "$worktree" rev-parse --short "$old")" ;;
      merge) kind="a merge commit on $(git -C "$worktree" rev-parse --short "$old")" ;;
    esac
    count=$(git -C "$worktree" rev-list --count "$old..$head")
    if [ "$count" = 1 ]; then kind="$kind with 1 commit"; else kind="$kind with $count commits"; fi
    if $dry_run; then
      printf '%s: would land in %s as %s%s\n' "$repository" "$target" "$kind" \
        "${checkout:+; would update the checkout at $checkout}"
      continue
    fi
    if [ -n "$checkout" ]; then
      GIT_REFLOG_ACTION="worktree-set land $name" git -C "$checkout" merge --ff-only --no-squash --quiet "$new" >&2 ||
        die "$repository: Git refused to update $checkout; the repositories above are landed, the others are not. Correct the cause and run land again"
    else
      git -C "$worktree" update-ref -m "worktree-set land $name" "refs/heads/$target" "$new" "$old" ||
        die "$repository: $target moved during the landing; the repositories above are landed, the others are not. Run land again"
    fi
    changes_are_in_base "$worktree" "$head" "refs/heads/$target" ||
      die "$repository: $target does not contain the changes of $name after the landing"
    printf '%s: landed in %s as %s, %s%s\n' "$repository" "$target" \
      "$(git -C "$worktree" rev-parse --short "$new")" "$kind" \
      "${checkout:+; updated the checkout at $checkout}"
  done
}

case ${1:-} in
  new | add | status | remove | land)
    command=$1
    shift
    root=$(find_root)
    "cmd_$command" "$@"
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
